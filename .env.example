# ==============================================
# BoxKhel Platform - Environment Configuration
# ==============================================

# 1. Database Connection (PostgreSQL with PostGIS)
# For Supabase / Neon, replace with your connection pooling and direct URLs:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Next.js App URL & Auth Secret
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="boxkhel-production-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# 3. Platform Business Defaults (Section 4.10)
PLATFORM_FEE_PERCENT=5
ONBOARDING_FREE_MONTHS=3
DEFAULT_CITY="Surat"

# 4. Cloudinary Image Uploads (Section 4.2)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 5. SMS / WhatsApp OTP Provider (Section 4.1 & 4.9)
# Options: MSG91, Twilio, or Wati
SMS_PROVIDER="MSG91"
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_OTP_TEMPLATE_ID="your_otp_template_id"

# 6. Maps & Geolocation (Optional)
NEXT_PUBLIC_MAPBOX_TOKEN="your_mapbox_public_token"
